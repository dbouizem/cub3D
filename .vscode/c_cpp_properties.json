{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/cc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "compilerArgs": [
        "-I${workspaceFolder}/include",
        "-I${workspaceFolder}/libft/includes",
        "-I${workspaceFolder}/minilibx"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/libft/includes",
        "${workspaceFolder}/minilibx",
        "${workspaceFolder}/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/libft/includes",
          "${workspaceFolder}/minilibx",
          "${workspaceFolder}/srcs",
          "${workspaceFolder}/libft/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [
        "_GNU_SOURCE"
      ]
    }
  ]
}
